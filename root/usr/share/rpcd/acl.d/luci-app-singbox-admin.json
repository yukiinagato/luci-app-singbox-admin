{
    "luci-app-singbox-admin": {
        "description": "Grant access to the sing-box dashboard, config editor and firewall script management",
        "read": {
            "cgi-io": [ "exec" ],
            "file": {
                "/etc/sing-box/config.json": [ "read" ],
                "/etc/sing-box/nftables.sh": [ "read" ],
                "/etc/sing-box/backups/*": [ "read" ],
                "/etc/sing-box/.nftables.good.sh": [ "read" ],
                "/tmp/sing-box*": [ "read" ],
                "/usr/libexec/singbox-fw.sh": [ "exec" ],
                "/usr/libexec/singbox-admin": [ "exec" ],
                "/etc/config/singbox": [ "read" ]
            },
            "uci": [ "singbox" ],
            "ubus": {
                "service": [ "list" ]
            }
        },
        "write": {
            "cgi-io": [ "exec" ],
            "file": {
                "/etc/sing-box/*": [ "write" ],
                "/etc/sing-box/backups/*": [ "write" ],
                "/tmp/sing-box*": [ "write" ],
                "/etc/config/singbox": [ "write" ],
                "/usr/libexec/singbox-admin": [ "exec" ],
                "/usr/libexec/singbox-fw.sh": [ "exec" ]
            },
            "uci": [ "singbox" ],
            "ubus": {
                "service": [ "start", "stop", "restart" ]
            }
        }
    }
}
